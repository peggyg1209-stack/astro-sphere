# ---------------------------------------------------------------------------
# Client-side (safe to expose — shipped in the browser bundle)
# ---------------------------------------------------------------------------

# Relay endpoint the consult form POSTs to. Must be YOUR endpoint, not a Lark
# API URL. Leave empty and the form falls back to the mailto link.
PUBLIC_LARK_CONTACT_ENDPOINT=

# ---------------------------------------------------------------------------
# Server-side only — set these as secrets on the relay (Worker / function).
# NEVER prefix them with PUBLIC_ and never commit real values.
# ---------------------------------------------------------------------------

# Lark / Feishu app credentials from the developer console
LARK_APP_ID=
LARK_APP_SECRET=

# Target 多维表格 (Bitable): app token (app_xxx) and table id (tbl_xxx)
LARK_BITABLE_APP_TOKEN=
LARK_TABLE_ID=

# Optional: custom bot incoming webhook for chat notifications
LARK_WEBHOOK_URL=

# Use https://open.feishu.cn for Feishu (China) tenants,
# or https://open.larksuite.com for Lark (international) tenants.
LARK_BASE_URL=https://open.feishu.cn
