---
import ConsultForm from "@components/ConsultForm.astro"
import { CONSULT } from "@consts"
import { t } from "@i18n/ui"
import { getLocaleFromUrl } from "@i18n/utils"

type Props = {
  /** Draw a hairline above the block. Used at the end of project pages. */
  divided?: boolean
}

const { divided = false } = Astro.props
const locale = getLocaleFromUrl(Astro.url)
---

<section
  id={CONSULT.ANCHOR}
  class:list={[
    "scroll-mt-24",
    divided && "mt-16 border-t border-black/10 pt-12 dark:border-white/20",
  ]}
>
  {/* Title is localized; English keeps the display serif + tracking. */}
  <h2
    class:list={[
      "text-2xl md:text-3xl text-black dark:text-white",
      locale === "en" ? "display tracking-[0.06em]" : "font-serif font-semibold",
    ]}
  >
    {t(locale, "consultFormTitle")}
  </h2>
  <p class="mt-2 opacity-75">
    {t(locale, "consultFormHint")}
  </p>

  <ConsultForm />
</section>
