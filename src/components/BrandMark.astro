---
type Props = {
  class?: string
}

const { class: className = "size-8" } = Astro.props
---

<svg
  class={className}
  viewBox="0 0 100 100"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <rect width="100" height="100" rx="20" class="fill-paper dark:fill-ink-raised"></rect>
  <g stroke-width="5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M32 72L68 28M68 28H48M68 28V48" class="stroke-pine"></path>
    <path d="M28 36V70C28 71.1 28.9 72 30 72H64" class="stroke-lake"></path>
    <circle cx="50" cy="50" r="3.5" class="fill-lake"></circle>
  </g>
</svg>
