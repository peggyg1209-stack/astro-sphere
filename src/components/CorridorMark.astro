---
/**
 * TYO as a hub radiating to overseas country nodes and the domestic axis:
 *   KUL · GRU · RUH  ‹──  ● TYO  ──›  PEK · SHA · SZX
 *   Malaysia, Brazil, Saudi Arabia          Beijing, Shanghai, Shenzhen
 */
---

<div
  class="inline-flex max-w-full flex-wrap items-center gap-x-2 gap-y-1 rounded-2xl border border-pine/20 bg-paper/70 px-2.5 py-1.5 font-mono dark:border-lake/25 dark:bg-ink-raised/80"
  aria-hidden="true"
>
  <span class="inline-flex shrink-0 items-center gap-[0.3rem] text-[clamp(0.5625rem,0.5rem+0.25vw,0.625rem)] font-semibold tracking-[0.08em] text-lake">
    <span class="size-1 rounded-full bg-lake/35"></span>
    <span title="Malaysia">KUL</span>
    <span class="text-[8px] font-medium text-lake/35">·</span>
    <span title="Brazil">GRU</span>
    <span class="text-[8px] font-medium text-lake/35">·</span>
    <span title="Saudi Arabia">RUH</span>
  </span>

  <span class="inline-flex shrink-0 items-center gap-1 text-lake/45">
    <svg class="size-2.5 stroke-current" viewBox="0 0 8 8" fill="none">
      <path d="M5 1.5L2 4L5 6.5" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
    <span class="h-px w-3 border-t border-dashed border-current sm:w-4"></span>
  </span>

  <span class="inline-flex shrink-0 items-center gap-1.5">
    <span class="relative flex size-2 shrink-0">
      <span class="absolute -inset-[4px] rounded-full border border-pine/25"></span>
      <span class="absolute -inset-[1.5px] rounded-full border border-pine/40"></span>
      <span class="size-2 rounded-full bg-pine"></span>
    </span>
    <span class="text-[clamp(0.625rem,0.55rem+0.3vw,0.6875rem)] font-bold tracking-[0.14em] text-pine">TYO</span>
  </span>

  <span class="inline-flex shrink-0 items-center gap-1 text-pine/45">
    <span class="h-px w-3 border-t border-dashed border-current sm:w-4"></span>
    <svg class="size-2.5 stroke-current" viewBox="0 0 8 8" fill="none">
      <path d="M3 1.5L6 4L3 6.5" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </span>

  <span class="inline-flex shrink-0 items-center gap-[0.3rem] text-[clamp(0.5625rem,0.5rem+0.25vw,0.625rem)] font-semibold tracking-[0.08em] text-black dark:text-white">
    <span>PEK</span>
    <span class="text-[8px] font-medium text-pine/35">·</span>
    <span>SHA</span>
    <span class="text-[8px] font-medium text-pine/35">·</span>
    <span>SZX</span>
    <span class="size-1 rounded-full bg-pine/30"></span>
  </span>
</div>
