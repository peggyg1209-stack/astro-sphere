---
// Self-hosted typefaces (no third-party font requests).
// Cormorant Garamond — Latin display headings (latin subset only).
import "@fontsource/cormorant-garamond/latin-400.css"
import "@fontsource/cormorant-garamond/latin-600.css"
// 思源宋体 / Noto Serif SC — Chinese headings and body copy.
// These entry points are unicode-range split, so a browser only downloads the
// glyph chunks a page actually renders rather than the full ~4.7MB face.
import "@fontsource/noto-serif-sc/400.css"
import "@fontsource/noto-serif-sc/600.css"
// JetBrains Mono — metadata / status microcopy.
import "@fontsource-variable/jetbrains-mono/wght.css"

import "@styles/global.css"
import BaseHead from "@components/BaseHead.astro"
import Header from "@components/Header.astro"
import Footer from "@components/Footer.astro"
import Drawer from "@components/Drawer.astro"
import { HREFLANG } from "@i18n/config"
import { t } from "@i18n/ui"
import { getLocaleFromUrl } from "@i18n/utils"

interface Props {
  title: string
  description: string
  image?: string
  keywords?: string[]
}

const { title, description, image, keywords } = Astro.props
const locale = getLocaleFromUrl(Astro.url)
const siteTitle = t(locale, "siteTitle")
---

<!doctype html>
<html lang={HREFLANG[locale]}>
  <head>
    <BaseHead title={`${title} | ${siteTitle}`} description={description} image={image} keywords={keywords} />
    <slot name="head" />
  </head>
  <body>
    <Header />
    <Drawer />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
