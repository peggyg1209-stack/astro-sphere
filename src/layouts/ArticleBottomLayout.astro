---
import { type CollectionEntry, getCollection } from "astro:content"
import MediaSlots from "@components/MediaSlots.astro"
import { t } from "@i18n/ui"
import { getLocaleFromUrl, localizePath } from "@i18n/utils"
import { localizedEntryBody, localizedEntryTitle, markdownToHtml } from "@lib/project"

type Props = {
  entry: CollectionEntry<"blog"> | CollectionEntry<"projects">
}

const { entry } = Astro.props
const { collection } = entry
const { Content } = await entry.render()
const locale = getLocaleFromUrl(Astro.url)
const translated =
  locale !== "zh" ? localizedEntryBody(collection, entry.slug, locale, "") : ""
const translatedHtml = translated ? markdownToHtml(translated) : null

const items = (await getCollection(collection))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
const index = items.findIndex((x) => x.slug === entry.slug)
const prev = items[(index - 1 + items.length) % items.length]
const next = items[(index + 1) % items.length]
---

<div>
  <article>
    {translatedHtml ? <div set:html={translatedHtml} /> : <Content />}
  </article>

  <MediaSlots entry={entry} />

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-12">
    <a
      href={localizePath(`/${prev.collection}/${prev.slug}/`, locale)}
      class="edge-glow cursor-glow group p-4 gap-3 flex items-center border rounded-lg hover:bg-paper-sunken dark:hover:bg-ink-soft border-black/15 dark:border-white/20 blend"
    >
      <div class="order-2 w-full h-full group-hover:text-black dark:group-hover:text-white blend">
        <div class="meta">
          {t(locale, "prev")}
        </div>
        <div class="font-semibold mt-2 text-black dark:text-white">
          {localizedEntryTitle(prev, locale)}
        </div>
      </div>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="order-1 shrink-0 stroke-current group-hover:stroke-pine dark:group-hover:stroke-lake-light rotate-180"
      >
        <line
          x1="5"
          y1="12"
          x2="19"
          y2="12"
          class="scale-x-0 group-hover:scale-x-100 translate-x-4 group-hover:translate-x-1 transition-all duration-300 ease-paper"
        />
        <polyline
          points="12 5 19 12 12 19"
          class="translate-x-0 group-hover:translate-x-1 transition-all duration-300 ease-paper"
        />
      </svg>
    </a>

    <a
      href={localizePath(`/${next.collection}/${next.slug}/`, locale)}
      class="edge-glow cursor-glow group p-4 gap-3 flex items-center border rounded-lg hover:bg-paper-sunken dark:hover:bg-ink-soft border-black/15 dark:border-white/20 blend"
    >
      <div class="w-full h-full text-right group-hover:text-black dark:group-hover:text-white blend">
        <div class="meta">
          {t(locale, "next")}
        </div>
        <div class="font-semibold mt-2 text-black dark:text-white">
          {localizedEntryTitle(next, locale)}
        </div>
      </div>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="shrink-0 stroke-current group-hover:stroke-pine dark:group-hover:stroke-lake-light"
      >
        <line
          x1="5"
          y1="12"
          x2="19"
          y2="12"
          class="scale-x-0 group-hover:scale-x-100 translate-x-4 group-hover:translate-x-1 transition-all duration-300 ease-paper"
        />
        <polyline
          points="12 5 19 12 12 19"
          class="translate-x-0 group-hover:translate-x-1 transition-all duration-300 ease-paper"
        />
      </svg>
    </a>
  </div>
</div>
