---
import { type CollectionEntry, getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"
import Search from "@components/Search"
import { t } from "@i18n/ui"
import { getLocaleFromUrl } from "@i18n/utils"

const locale = getLocaleFromUrl(Astro.url)
const posts = (await getCollection("blog")).filter((post) => !post.data.draft)
const projects = (await getCollection("projects")).filter((post) => !post.data.draft)
const data = [...posts, ...projects] as CollectionEntry<"blog">[]
---

<PageLayout title={t(locale, "search")} description={t(locale, "searchDescription")}>
  <TopLayout>
    <div class="animate page-heading">
      {t(locale, "search")}
    </div>
  </TopLayout>
  <BottomLayout>
    <div class="animate">
      <Search
        client:load
        data={data}
        locale={locale}
        placeholderText={t(locale, "searchPlaceholder")}
        foundLabel={t(locale, "foundResults")}
        resultsForLabel={t(locale, "resultsFor")}
      />
    </div>
  </BottomLayout>
</PageLayout>
